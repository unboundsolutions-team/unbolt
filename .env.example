# Unbolt — environment
#
# This file is checked against the source by tests/integration/env-requirements.test.ts:
# a variable here that nothing reads fails the suite, and so does a variable the
# code reads that is not here. It had drifted both ways — it documented Upstash
# Redis, Sentry, PostHog and Resend, none of which anything reads, and omitted
# NEXT_PUBLIC_APP_ENV, which decides whether the security policy is enforced.
#
# `npm run preflight` checks a real environment against src/server/env-requirements.ts,
# which says what breaks when each of these is missing.

# ── Deploy context ─────────────────────────────────────────────────
# netlify.toml sets these per context; they are here for local runs.
#
# NEXT_PUBLIC_APP_ENV is the highest-consequence variable in this file, because
# a wrong value looks exactly like a right one. Anything other than "production"
# serves the Content-Security-Policy report-only, allows 'unsafe-eval', and
# disables the BETTER_AUTH_SECRET guard below.
NEXT_PUBLIC_APP_ENV=development
# Canonical URLs, sitemap and Open Graph tags. Must be a domain actually
# attached to the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────
# Netlify injects NETLIFY_DATABASE_URL once the Netlify DB extension is enabled
# on the site. Never set it by hand; if it is empty, the extension is not on.
NETLIFY_DATABASE_URL=

# Local development only. A plain postgres:// URL, honoured ONLY when
# NODE_ENV !== "production", so a stray value here can never point live traffic
# at a dev database. This is also why `next start` cannot serve the
# database-backed routes locally — it forces NODE_ENV=production.
DEVELOPMENT_DATABASE_URL=

# Integration tests. Kept separate from the dev database deliberately: the
# suite truncates users on every reset, so sharing one silently wipes the demo
# seed.
TEST_DATABASE_URL=

# ── Auth ───────────────────────────────────────────────────────────
# REQUIRED in production — src/lib/auth.ts refuses to start without it, because
# Better Auth's fallback secret is public and would make every session token
# forgeable. Must NOT equal SHOPIFY_TOKEN_KEY: sharing one value welds two
# independent rotation schedules together.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Shopify OAuth ──────────────────────────────────────────────────
# From the Shopify Partner dashboard. The app's "Allowed redirection URL" must
# be exactly <SHOPIFY_APP_URL>/api/shopify/callback, or Shopify refuses the
# install with a mismatch error that names nothing useful.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Absolute origin of THIS app. Falls back to BETTER_AUTH_URL if unset.
SHOPIFY_APP_URL=
# Encrypts merchant access tokens at rest (AES-256-GCM). 32+ chars.
# Set it BEFORE the first store connects — changing it afterwards makes every
# stored token undecryptable and every merchant has to reinstall.
#   openssl rand -base64 32
SHOPIFY_TOKEN_KEY=

# ── Store Health Scan ──────────────────────────────────────────────
# Google PageSpeed Insights. Without it the scan reaches the store, confirms it
# is live, and reports that the scanner is being set up. It never invents
# scores, so running without this is a supported state, not a broken one.
PAGESPEED_API_KEY=

# ── Stripe ─────────────────────────────────────────────────────────
# Optional. The product is sales-led: an admin provisions the account and
# confirms payment by hand. These switch on the self-serve path.
# Setting STRIPE_SECRET_KEY without STRIPE_WEBHOOK_SECRET means payments
# succeed and grant no credits, so the preflight demands the pair.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
