# better-auth declares @sveltejs/kit as an OPTIONAL peer. npm still tries to
# resolve its transitive peers, and @sveltejs/vite-plugin-svelte@7 demands
# vite@8 while vitest pins vite@7 — an ERESOLVE between two frameworks we do
# not use. Without this, `npm ci` fails in GitHub Actions and on Netlify even
# though the installed tree is correct.
#
# Revisit when better-auth drops the optional SvelteKit peer.
legacy-peer-deps=true
